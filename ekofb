<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EkoFB Kart | İzmir'in Taraftar ve İndirim Kulübü</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans">

    <!-- Header / Navbar -->
    <header class="border-b border-slate-800 py-4 px-6 flex justify-between items-center max-w-4xl mx-auto">
        <h1 class="text-xl font-black tracking-wider text-yellow-400">EkoFB <span class="text-white">KART</span></h1>
        <a href="#sponsorlar" class="bg-yellow-400 text-slate-950 font-bold px-4 py-2 rounded-xl text-sm hover:bg-yellow-300 transition">Sponsorlar</a>
    </header>

    <!-- Hero Section -->
    <section class="max-w-4xl mx-auto px-6 py-16 text-center">
        <span class="bg-yellow-400/10 text-yellow-400 border border-yellow-400/20 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-widest">İzmir Ekonomi Üni • Ekofb</span>
        <h2 class="text-4xl sm:text-5xl font-extrabold mt-6 leading-tight">Tek Kartla Kahveden Yemeğe İndirim Masada!</h2>
        <p class="text-slate-400 mt-4 text-base sm:text-lg max-w-xl mx-auto">Ekofb Kart ile kampüs çevresindeki anlaşmalı mekanlarda özel indirimlerden yararlan, kulübe destek ol.</p>
        <div class="mt-8 flex justify-center gap-4">
            <a href="#sponsorlar" class="bg-yellow-400 text-slate-950 font-bold px-6 py-3 rounded-xl hover:bg-yellow-300 transition">İndirimleri Gör</a>
        </div>
    </section>

    <!-- Sponsorlar Section -->
    <section id="sponsorlar" class="max-w-4xl mx-auto px-6 py-12 border-t border-slate-900">
        <h3 class="text-2xl font-bold mb-6 text-yellow-400">Anlaşmalı Mekanlar & İndirimler</h3>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Örnek Mekan Kartı -->
            <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl">
                <div class="flex justify-between items-start">
                    <h4 class="font-bold text-lg text-white">Örnek Kafe (Küçükpark)</h4>
                    <span class="bg-emerald-500/10 text-emerald-400 text-xs font-bold px-2.5 py-1 rounded-lg">%15 İndirim</span>
                </div>
                <p class="text-slate-400 text-sm mt-2">Tüm sıcak içeceklerde ve kahvaltılarda geçerlidir.</p>
            </div>

            <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl">
                <div class="flex justify-between items-start">
                    <h4 class="font-bold text-lg text-white">Burger & Fast Food Mekanı</h4>
                    <span class="bg-emerald-500/10 text-emerald-400 text-xs font-bold px-2.5 py-1 rounded-lg">Özel Menü</span>
                </div>
                <p class="text-slate-400 text-sm mt-2">Ekofb kart sahiplerine özel set menülerde %20 indirim.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="text-center py-8 text-slate-600 text-sm border-t border-slate-900 mt-12">
        <p>© 2026 Ekonomi Fenerbahçeliler Topluluğu. Tüm hakları saklıdır.</p>
    </footer>

</body>
</html>
